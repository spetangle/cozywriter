# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/

# Data - 用户项目数据 / 模型 / 向量库 / 日志（绝不入版本控制）
# 注意：data/ 本身（目录）需要保留，递归忽略其内容用 data/**
data/**
!data/.gitkeep

# 日志：根目录 server.log 及任意位置 *.log
# （勿在规则后写行内注释，gitignore 不支持，会导致规则失效）
*.log
server.log

# Environment - 真实 API Key 等敏感信息
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# 本地 AI 助手开发产物 / 缓存（非项目代码，含历史前后端备份）
.codebuddy/
.workbuddy/
.trae/
.claude/

# OS
.DS_Store
Thumbs.db
temp/
