# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/

# Data - 用户项目数据 / 模型 / 向量库 / 日志（绝不入版本控制）
# 注意：data/ 本身（目录）需要保留，递归忽略其内容用 data/**
data/**
!data/.gitkeep
data/models/             # embedding 模型文件 (~400MB)
data/chroma/             # ChromaDB 向量库
data/logs/               # 日志文件
data/*.db                # SQLite 主数据库
*.log                    # 全局日志

# Environment - 真实 API Key 等敏感信息
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
temp/
