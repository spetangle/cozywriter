# CozyWriter 环境变量模板
# 复制此文件为 .env 并填写实际值

# LLM Provider API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# MiniMax（MiniMax 大模型）
# 官方文档: https://platform.minimaxi.com/docs/api-reference/anthropic-api
# API 协议: Anthropic Messages 兼容（基于官方 anthropic Python SDK 调用）
# ⚠️ MINIMAX_BASE_URL 必须以 /anthropic 结尾（SDK 内部会拼 /v1/messages）
# 鉴权: Authorization: Bearer <MINIMAX_API_KEY>
MINIMAX_API_KEY=eyJxxxxx
MINIMAX_MODEL=MiniMax-M2.7
# 可选: MiniMax-M3 (多模态/1M 上下文，可能需单独开通权限) / M2.7 / M2.5 / M2.1 / M2
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# Xiaomi MiMo（小米大模型）
# 接入方式：Anthropic Messages 兼容协议
# 鉴权: Authorization: Bearer <MIMO_API_KEY>
MIMO_API_KEY=YOUR_MIMO_KEY_HERE
MIMO_MODEL=mimo-v2.5-pro
# 可用模型: mimo-v2.5-pro / mimo-v2.5 / mimo-v2.5-asr / mimo-v2.5-tts / mimo-v2.5-tts-voiceclone
#            mimo-v2.5-tts-voicedesign / mimo-v2-pro / mimo-v2-omni / mimo-v2-tts
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic

# Ollama 本地模型配置
OLLAMA_BASE_URL=http://localhost:11434

# Embedding 模型配置
EMBEDDING_MODEL=moka-ai/m3e-base

# HuggingFace 镜像（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# 数据存储路径
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma
DATABASE_URL=sqlite:///./data/cozywriter.db
