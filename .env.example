# CozyWriter 环境变量模板
# 复制此文件为 .env 并填写实际值

# LLM Provider API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# MiniMax（MiniMax 大模型）
# 官方文档: https://platform.minimaxi.com/docs/guides/models-intro
# API 协议: Anthropic Messages 兼容（POST {base_url}/anthropic/v1/messages）
# 鉴权: Authorization: Bearer <MINIMAX_API_KEY>
MINIMAX_API_KEY=eyJxxxxx
MINIMAX_MODEL=MiniMax-M2.7
# 可选: MiniMax-M3 (多模态/1M 上下文) / M2.5 / M2.1 / M2
MINIMAX_BASE_URL=https://api.minimaxi.com

# Ollama 本地模型配置
OLLAMA_BASE_URL=http://localhost:11434

# 默认 LLM Provider: anthropic / openai / MiniMax / ollama
DEFAULT_LLM_PROVIDER=MiniMax

# Embedding 模型配置
EMBEDDING_MODEL=moka-ai/m3e-base

# HuggingFace 镜像（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# 数据存储路径
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma
DATABASE_URL=sqlite:///./data/cozywriter.db
